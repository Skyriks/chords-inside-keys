@prefix : <https://example.org/chords-inside-keys#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/chords-inside-keys> a owl:Ontology ;
    rdfs:label "Chords inside keys - first draft" ;
    owl:versionInfo "0.1 draft" ;
    rdfs:comment "Small example for discussion. Key membership and functions are entered by hand for now." .

:Note a owl:Class ; rdfs:comment "A spelled note without an octave, such as C or F sharp." .
:Interval a owl:Class ; rdfs:comment "An interval type, such as MajorThird. It is not a pair of notes." .
:Chord a owl:Class .
:Key a owl:Class .
:HarmonicFunction a owl:Class .
:ChordInKey a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty :hasChord ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Chord ],
        [ a owl:Restriction ; owl:onProperty :belongsToKey ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass :Key ] .

[] a owl:AllDisjointClasses ;
   owl:members ( :Note :Interval :Chord :Key :HarmonicFunction :ChordInKey ) .

:Triad a owl:Class ; rdfs:subClassOf :Chord,
    [ a owl:Restriction ; owl:onProperty :hasNote ;
      owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass :Note ] ;
    rdfs:comment "Three-note chord built in thirds. The cardinality alone does not define a triad." .

# These intervals are measured from the root, not between every pair of notes.
:MajorChord a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
    :Triad
    [ a owl:Restriction ; owl:onProperty :hasInterval ; owl:hasValue :MajorThird ]
    [ a owl:Restriction ; owl:onProperty :hasInterval ; owl:hasValue :PerfectFifth ]
) ] .
:MinorChord a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
    :Triad
    [ a owl:Restriction ; owl:onProperty :hasInterval ; owl:hasValue :MinorThird ]
    [ a owl:Restriction ; owl:onProperty :hasInterval ; owl:hasValue :PerfectFifth ]
) ] .
:DiminishedChord a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
    :Triad
    [ a owl:Restriction ; owl:onProperty :hasInterval ; owl:hasValue :MinorThird ]
    [ a owl:Restriction ; owl:onProperty :hasInterval ; owl:hasValue :Tritone ]
) ] .
[] a owl:AllDisjointClasses ; owl:members ( :MajorChord :MinorChord :DiminishedChord ) .

:MajorKey a owl:Class ; rdfs:subClassOf :Key .
:MinorKey a owl:Class ; rdfs:subClassOf :Key ;
    rdfs:comment "Natural minor only in this draft." .
:MajorKey owl:disjointWith :MinorKey .

# A function belongs to the chord-in-key example, not to the chord itself.
:TonicChord a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
    :ChordInKey [ a owl:Restriction ; owl:onProperty :hasFunction ; owl:hasValue :Tonic ]
) ] .
:SubdominantChord a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
    :ChordInKey [ a owl:Restriction ; owl:onProperty :hasFunction ; owl:hasValue :Subdominant ]
) ] .
:DominantChord a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
    :ChordInKey [ a owl:Restriction ; owl:onProperty :hasFunction ; owl:hasValue :Dominant ]
) ] .
:PrimaryChord a owl:Class ; owl:equivalentClass [ a owl:Class ;
    owl:unionOf ( :TonicChord :SubdominantChord :DominantChord ) ] .
:DiatonicChord a owl:Class ; rdfs:subClassOf :ChordInKey ;
    rdfs:comment "An occurrence whose chord uses only notes of its key. Entered by hand until a rule or query checks this." .

:hasNote a owl:ObjectProperty ; rdfs:domain :Chord ; rdfs:range :Note .
:hasRoot a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Chord ; rdfs:range :Note ; rdfs:subPropertyOf :hasNote ; owl:inverseOf :isRootOf .
:isRootOf a owl:ObjectProperty ; rdfs:domain :Note ; rdfs:range :Chord .
:hasThird a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Triad ; rdfs:range :Note ; rdfs:subPropertyOf :hasNote .
:hasFifth a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Triad ; rdfs:range :Note ; rdfs:subPropertyOf :hasNote .
:hasInterval a owl:ObjectProperty ; rdfs:domain :Chord ; rdfs:range :Interval .
:hasTonic a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :Key ; rdfs:range :Note .
:containsNote a owl:ObjectProperty ; rdfs:domain :Key ; rdfs:range :Note .
:hasRelativeKey a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain :Key ; rdfs:range :Key .
:hasChord a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :ChordInKey ; rdfs:range :Chord .
:belongsToKey a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :ChordInKey ; rdfs:range :Key .
:hasFunction a owl:ObjectProperty ; rdfs:domain :ChordInKey ; rdfs:range :HarmonicFunction .

:C a :Note . :D a :Note . :E a :Note . :F a :Note .
:G a :Note . :A a :Note . :B a :Note . :Fsharp a :Note . :Bflat a :Note .
[] a owl:AllDifferent ; owl:distinctMembers ( :C :D :E :F :G :A :B :Fsharp :Bflat ) .

:MinorSecond a :Interval . :MajorSecond a :Interval .
:MinorThird a :Interval . :MajorThird a :Interval .
:PerfectFourth a :Interval . :Tritone a :Interval . :PerfectFifth a :Interval .
:MinorSixth a :Interval . :MajorSixth a :Interval .
:MinorSeventh a :Interval . :MajorSeventh a :Interval . :PerfectOctave a :Interval .
[] a owl:AllDifferent ; owl:distinctMembers (
    :MinorSecond :MajorSecond :MinorThird :MajorThird :PerfectFourth :Tritone
    :PerfectFifth :MinorSixth :MajorSixth :MinorSeventh :MajorSeventh :PerfectOctave
) .
:Tonic a :HarmonicFunction . :Subdominant a :HarmonicFunction . :Dominant a :HarmonicFunction .
[] a owl:AllDifferent ; owl:distinctMembers ( :Tonic :Subdominant :Dominant ) .

# I left out the MajorChord type here so the reasoner has something to infer.
:CMajorChord a :Triad ; :hasRoot :C ; :hasThird :E ; :hasFifth :G ;
    :hasNote :C, :E, :G ; :hasInterval :MajorThird, :PerfectFifth .
:FMajorChord a :Triad ; :hasRoot :F ; :hasThird :A ; :hasFifth :C ;
    :hasNote :F, :A, :C ; :hasInterval :MajorThird, :PerfectFifth .
:GMajorChord a :Triad ; :hasRoot :G ; :hasThird :B ; :hasFifth :D ;
    :hasNote :G, :B, :D ; :hasInterval :MajorThird, :PerfectFifth .
:AMinorChord a :Triad ; :hasRoot :A ; :hasThird :C ; :hasFifth :E ;
    :hasNote :A, :C, :E ; :hasInterval :MinorThird, :PerfectFifth .
:BDiminishedChord a :Triad ; :hasRoot :B ; :hasThird :D ; :hasFifth :F ;
    :hasNote :B, :D, :F ; :hasInterval :MinorThird, :Tritone .

# These are complete note sets for the four example keys.
:CMajorKey a :MajorKey ; :hasTonic :C ; :containsNote :C, :D, :E, :F, :G, :A, :B ;
    :hasRelativeKey :AMinorKey ;
    a [ a owl:Restriction ; owl:onProperty :containsNote ;
        owl:allValuesFrom [ a owl:Class ; owl:oneOf ( :C :D :E :F :G :A :B ) ] ] .
:GMajorKey a :MajorKey ; :hasTonic :G ; :containsNote :G, :A, :B, :C, :D, :E, :Fsharp ;
    a [ a owl:Restriction ; owl:onProperty :containsNote ;
        owl:allValuesFrom [ a owl:Class ; owl:oneOf ( :G :A :B :C :D :E :Fsharp ) ] ] .
:FMajorKey a :MajorKey ; :hasTonic :F ; :containsNote :F, :G, :A, :Bflat, :C, :D, :E ;
    a [ a owl:Restriction ; owl:onProperty :containsNote ;
        owl:allValuesFrom [ a owl:Class ; owl:oneOf ( :F :G :A :Bflat :C :D :E ) ] ] .
:AMinorKey a :MinorKey ; :hasTonic :A ; :containsNote :A, :B, :C, :D, :E, :F, :G ;
    a [ a owl:Restriction ; owl:onProperty :containsNote ;
        owl:allValuesFrom [ a owl:Class ; owl:oneOf ( :A :B :C :D :E :F :G ) ] ] .
[] a owl:AllDifferent ; owl:distinctMembers ( :CMajorKey :GMajorKey :FMajorKey :AMinorKey ) .

:C_in_C a :ChordInKey, :DiatonicChord ;
    :hasChord :CMajorChord ; :belongsToKey :CMajorKey ; :hasFunction :Tonic .
:C_in_G a :ChordInKey, :DiatonicChord ;
    :hasChord :CMajorChord ; :belongsToKey :GMajorKey ; :hasFunction :Subdominant .
:G_in_C a :ChordInKey, :DiatonicChord ;
    :hasChord :GMajorChord ; :belongsToKey :CMajorKey ; :hasFunction :Dominant .
:F_in_C a :ChordInKey, :DiatonicChord ;
    :hasChord :FMajorChord ; :belongsToKey :CMajorKey ; :hasFunction :Subdominant .
:Aminor_in_Aminor a :ChordInKey, :DiatonicChord ;
    :hasChord :AMinorChord ; :belongsToKey :AMinorKey ; :hasFunction :Tonic .
